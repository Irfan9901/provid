{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Provid",
  "version": "0.1.0",
  "identifier": "com.cerdasdigital.provid",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Provid",
        "width": 1000,
        "height": 1000
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.icns"
    ],
    "externalBin": [
      "bin/ffmpeg"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": null
    }
  },
  "plugins": {
    "dialog": null,
    "shell": null
  }
}